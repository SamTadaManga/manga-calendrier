{
  "name": "manga-calendrier",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Compteur de clics anonyme : l'espace de stockage est créé automatiquement au premier déploiement.
  "kv_namespaces": [{ "binding": "CLICS" }]
}
